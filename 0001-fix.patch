+        const steps = Array.from(document.querySelectorAll('.step'));
+        const t = steps.find(el => el.innerText && el.innerText.trim().includes("{step_name}"));
+        if (t) {{ t.click(); return true; }}
+        return false;
+    }}''')
+    if not clicked:
+        await safe_click_by_text(page, step_name, bot, user_id)
